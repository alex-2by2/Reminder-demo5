# Render supplies PORT automatically. Keep this for local development only.
PORT=10000
NODE_ENV=development

# Public frontend origins allowed to call this API. Add your GitHub Pages / Firebase Hosting / custom domain URL.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5000,https://your-frontend.example.com

# MongoDB Atlas connection. Leave blank if you only need Firebase Functions/Firestore.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=reminder_demo5

# Firebase Admin SDK service account values. Store these as Render secret environment variables.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Backend owner allow-list. Use either uid, email, or both. Comma-separated.
OWNER_UIDS=your-firebase-auth-uid
OWNER_EMAILS=owner@example.com
