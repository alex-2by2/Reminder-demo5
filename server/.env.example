# Copy this file to .env for local development. Never commit the real .env —
# it's already in .gitignore. On Render, you'll set these same names as
# Environment Variables in the dashboard instead of a file (see server/README.md).

# ---- Who's allowed in -------------------------------------------------------
# At least ONE of these two must be set, or every request is rejected — this
# server fails CLOSED (denies everyone) if no owner is configured, not open.
# Find your UID in Firebase Console -> Authentication -> Users, after you've
# signed up in the app at least once with the account you want as the owner.
OWNER_UID=
OWNER_EMAIL=

# ---- Firebase Admin SDK credentials -----------------------------------------
# Base64 of the ENTIRE service account JSON file (see README.md "1. Firebase
# service account" for the exact command). Base64 avoids a common bug where
# the private key's embedded newlines get mangled when pasted into a plain
# env var.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ---- CORS --------------------------------------------------------------------
# Only needed if you'll call this API from a page NOT served by this same
# server (the bundled admin.html is served by this server itself, so it works
# without this being set at all). Comma-separated list of allowed origins,
# e.g. https://your-admin-tool.example.com — no trailing slash.
ADMIN_ORIGIN=

# ---- Misc ----------------------------------------------------------------
PORT=3000
NODE_ENV=production
